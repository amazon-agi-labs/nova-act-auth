# nova_act_auth sample configuration
# Copy to samples/.env and fill in your values:
#   cp samples/.env.example samples/.env
#
# Then source before running samples:
#   source samples/.env
#   python -m samples.sso_authenticate
#
# SECURITY: Never commit samples/.env to version control.
# For production, retrieve secrets from AWS Secrets Manager or
# Parameter Store instead of storing them in environment files.

# --- Required: Cognito configuration ---

# Cognito Hosted UI domain (e.g., my-app.auth.us-east-1.amazoncognito.com)
AGENT_AUTH_COGNITO_DOMAIN=

# Cognito App Client ID (public client, no secret)
AGENT_AUTH_COGNITO_CLIENT_ID=

# --- Optional: SSO settings ---

# Skip the Hosted UI IdP selector and redirect straight to this IdP
# IdP name as configured in Cognito. Leave unset to show the selector.
# AGENT_AUTH_IDP_NAME=

# Callback strategy: localhost (default), playwright, or agentcore
# AGENT_AUTH_CALLBACK=localhost

# Localhost port for the OAuth callback server (default: 8976)
# AGENT_AUTH_CALLBACK_PORT=8976

# Seconds to wait for the user to complete SSO (default: 120)
# AGENT_AUTH_CALLBACK_TIMEOUT=120

# Profile name for token storage (default: default)
# AGENT_AUTH_PROFILE=default

# --- Optional: token persistence ---

# Token store backend: s3
# AGENT_AUTH_TOKEN_STORE=s3

# S3 bucket for token storage (required when store=s3)
# AGENT_AUTH_S3_BUCKET=

# AWS KMS key ID or alias for SSE-KMS encryption (optional, for s3 store)
# AGENT_AUTH_S3_KMS_KEY=

# AWS region for AgentCore Browser and S3 (default: us-east-1)
# AGENT_AUTH_REGION=us-east-1

# --- Optional: authorization policies (sso_then_agent.py only) ---

# Amazon Verified Permissions policy store ID (for --policy=avp)
# AGENT_AUTH_AVP_POLICY_STORE_ID=
